{
	"manifest_version": 3,
	"name": "WhyTime",
	"version": "0.16.2",
	"description": "打开之前，先想清楚为什么。",

	"icons": {
		"16": "icons/icon16.png",
		"32": "icons/icon32.png",
		"48": "icons/icon48.png",
		"128": "icons/icon128.png"
	},

	"action": {
		"default_icon": {
			"16": "icons/icon16.png",
			"32": "icons/icon32.png"
		},
		"default_title": "WhyTime"
	},

	"permissions": [
		"alarms",
		"storage"
	],

	"background": {
		"service_worker": "background.js"
	},

	"content_scripts": [
		{
			"matches": ["<all_urls>"],
			"js": ["common.js", "wt-util.js", "content.js"],
			"run_at": "document_start"
		}
	],

	"options_ui": {
		"page": "options.html",
		"open_in_tab": true
	}
}
